{
  "appId": "com.natoons.nadspdf",
  "productName": "NADSPDF",
  "directories": {
    "output": "release",
    "buildResources": "assets"
  },
  "files": ["dist/**/*", "dist-electron/**/*"],
  "win": {
    "target": ["nsis", "portable"],
    "icon": "assets/logo.png"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "NADSPDF"
  }
}
