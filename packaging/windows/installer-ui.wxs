<?xml version="1.0" encoding="utf-8"?>
<!-- NadsPDF's own installer screens, in French: native MSI dialogs with the nads banner
     (assets/app-icon/installer-banner.bmp, drawn by packaging/nads_icons.py). No
     custom-action DLLs: launching NadsPDF and opening Windows' Default apps page are plain EXE
     custom actions run as the user from the UI. Full UI gets welcome (desktop-shortcut and
     right-click-menu checkboxes) / progress / outcome screens; /qn and /qb stay unattended. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <Binary Id="NadsBanner" SourceFile="$(sys.SOURCEFILEDIR)..\..\assets\app-icon\installer-banner.bmp" />

    <!-- Finish > "Lancer NadsPDF" (ticked by default). -->
    <Property Id="LAUNCHNADSPDF" Value="1" />
    <CustomAction Id="LaunchNadsPDF" FileRef="PdfcraftExe" ExeCommand="" Return="asyncNoWait" Execute="immediate" Impersonate="yes" />
    <!-- Windows doesn't let an installer take over .pdf (the user's choice is protected), so the
         last screen opens Settings > Default apps on NadsPDF's page, where one click does it. -->
    <CustomAction Id="OpenDefaultApps" Directory="INSTALLFOLDER"
        ExeCommand="&quot;[WindowsFolder]explorer.exe&quot; &quot;ms-settings:defaultapps?registeredAppMachine=NadsPDF&quot;"
        Return="asyncNoWait" Execute="immediate" Impersonate="yes" />

    <UI Id="PdfcraftInstallerUI">
      <TextStyle Id="InstallerNormal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="InstallerTitle" FaceName="Segoe UI Semibold" Size="13" />
      <TextStyle Id="InstallerMuted" FaceName="Segoe UI" Size="8" Red="110" Green="110" Blue="118" />
      <Property Id="DefaultUIFont" Value="InstallerNormal" />

      <Dialog Id="InstallWelcome" Width="400" Height="270" Title="Installation de [ProductName]">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="400" Height="66" Text="NadsBanner" TabSkip="yes" />
        <Control Id="Title" Type="Text" X="24" Y="80" Width="352" Height="22" Text="{\InstallerTitle}Bienvenue dans NadsPDF" />
        <Control Id="Description" Type="Text" X="24" Y="106" Width="352" Height="34"
            Text="NadsPDF va être installé pour tous les comptes de cet ordinateur et ajouté au menu Démarrer. Tout reste sur votre PC : aucun compte, aucune télémétrie." />
        <Control Id="DesktopShortcut" Type="CheckBox" X="24" Y="150" Width="352" Height="17"
            Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1" Text="Créer un &amp;raccourci sur le Bureau" />
        <Control Id="PdfContextMenu" Type="CheckBox" X="24" Y="170" Width="352" Height="17"
            Property="INSTALLPDFCONTEXTMENU" CheckBoxValue="1" Text="Ajouter NadsPDF au &amp;clic droit de l'Explorateur (ouvrir, convertir, fusionner)" />
        <Control Id="Note" Type="Text" X="24" Y="196" Width="352" Height="24"
            Text="{\InstallerMuted}Windows demandera l'autorisation d'administrateur. Vous pourrez désinstaller NadsPDF depuis Paramètres > Applications." />
        <Control Id="Line" Type="Line" X="0" Y="232" Width="400" Height="0" />
        <Control Id="Install" Type="PushButton" X="226" Y="241" Width="80" Height="22" Default="yes" ElevationShield="yes" Text="&amp;Installer">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="314" Y="241" Width="70" Height="22" Cancel="yes" Text="Annuler">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="InstallMaintenance" Width="400" Height="270" Title="Installation de [ProductName]">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="400" Height="66" Text="NadsBanner" TabSkip="yes" />
        <Control Id="Title" Type="Text" X="24" Y="80" Width="352" Height="22" Text="{\InstallerTitle}NadsPDF est déjà installé" />
        <Control Id="Description" Type="Text" X="24" Y="106" Width="352" Height="60"
            Text="Réparer remet en place les fichiers et raccourcis manquants. Supprimer désinstalle NadsPDF ; vos PDF ne sont pas touchés." />
        <Control Id="Line" Type="Line" X="0" Y="232" Width="400" Height="0" />
        <Control Id="Repair" Type="PushButton" X="138" Y="241" Width="80" Height="22" Default="yes" ElevationShield="yes" Text="&amp;Réparer">
          <Publish Property="REINSTALL" Value="ALL" Order="1" />
          <Publish Property="REINSTALLMODE" Value="amus" Order="2" />
          <Publish Event="EndDialog" Value="Return" Order="3" />
        </Control>
        <Control Id="Remove" Type="PushButton" X="226" Y="241" Width="80" Height="22" ElevationShield="yes" Text="&amp;Supprimer">
          <Publish Property="REMOVE" Value="ALL" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="314" Y="241" Width="70" Height="22" Cancel="yes" Text="Annuler">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="InstallProgress" Width="400" Height="270" Title="Installation de [ProductName]" Modeless="yes">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="400" Height="66" Text="NadsBanner" TabSkip="yes" />
        <Control Id="Title" Type="Text" X="24" Y="80" Width="352" Height="22" Text="{\InstallerTitle}Installation en cours…" />
        <!-- No ActionText table is authored: subscribing would blank this message (#305). -->
        <Control Id="Status" Type="Text" X="24" Y="110" Width="352" Height="30" Text="Patientez pendant la mise en place de NadsPDF." />
        <Control Id="Progress" Type="ProgressBar" X="24" Y="148" Width="352" Height="14" ProgressBlocks="yes">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="Line" Type="Line" X="0" Y="232" Width="400" Height="0" />
        <Control Id="Cancel" Type="PushButton" X="314" Y="241" Width="70" Height="22" Cancel="yes" Text="Annuler">
          <Publish Event="SpawnDialog" Value="ConfirmCancel" />
        </Control>
      </Dialog>

      <Dialog Id="ConfirmCancel" Width="300" Height="110" Title="Annuler l'installation">
        <Control Id="Description" Type="Text" X="20" Y="20" Width="260" Height="35" Text="Annuler l'installation de [ProductName] ?" />
        <Control Id="Yes" Type="PushButton" X="130" Y="70" Width="70" Height="22" Text="&amp;Oui">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="No" Type="PushButton" X="210" Y="70" Width="70" Height="22" Default="yes" Cancel="yes" Text="&amp;Non">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="InstallComplete" Width="400" Height="270" Title="Installation de [ProductName]">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="400" Height="66" Text="NadsBanner" TabSkip="yes" />
        <Control Id="Title" Type="Text" X="24" Y="80" Width="352" Height="22" Text="{\InstallerTitle}NadsPDF est prêt" />
        <Control Id="Description" Type="Text" X="24" Y="106" Width="352" Height="34"
            Text="L'installation s'est terminée avec succès. NadsPDF est dans le menu Démarrer." />
        <Control Id="DefaultApp" Type="PushButton" X="24" Y="146" Width="230" Height="22" Text="Faire de NadsPDF mon &amp;lecteur PDF…">
          <Publish Event="DoAction" Value="OpenDefaultApps" />
        </Control>
        <Control Id="DefaultAppNote" Type="Text" X="24" Y="172" Width="352" Height="24"
            Text="{\InstallerMuted}Ouvre Paramètres > Applications par défaut sur NadsPDF : choisissez-le pour les fichiers .pdf." />
        <Control Id="Launch" Type="CheckBox" X="24" Y="204" Width="352" Height="17"
            Property="LAUNCHNADSPDF" CheckBoxValue="1" Text="&amp;Lancer NadsPDF maintenant" />
        <Control Id="Line" Type="Line" X="0" Y="232" Width="400" Height="0" />
        <Control Id="Finish" Type="PushButton" X="314" Y="241" Width="70" Height="22" Default="yes" Cancel="yes" Text="&amp;Terminer">
          <Publish Event="DoAction" Value="LaunchNadsPDF" Condition="LAUNCHNADSPDF = 1 AND NOT Installed" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
      </Dialog>

      <Dialog Id="InstallFailed" Width="400" Height="270" Title="Installation de [ProductName]">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="400" Height="66" Text="NadsBanner" TabSkip="yes" />
        <Control Id="Title" Type="Text" X="24" Y="80" Width="352" Height="22" Text="{\InstallerTitle}L'installation a échoué" />
        <Control Id="Description" Type="Text" X="24" Y="106" Width="352" Height="60"
            Text="NadsPDF n'a pas pu être installé. Corrigez l'erreur signalée (par exemple fermez NadsPDF s'il est ouvert) et relancez l'installation." />
        <Control Id="Line" Type="Line" X="0" Y="232" Width="400" Height="0" />
        <Control Id="Finish" Type="PushButton" X="314" Y="241" Width="70" Height="22" Default="yes" Cancel="yes" Text="&amp;Terminer">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="InstallCancelled" Width="400" Height="270" Title="Installation de [ProductName]">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="400" Height="66" Text="NadsBanner" TabSkip="yes" />
        <Control Id="Title" Type="Text" X="24" Y="80" Width="352" Height="22" Text="{\InstallerTitle}Installation annulée" />
        <Control Id="Description" Type="Text" X="24" Y="106" Width="352" Height="60"
            Text="Rien n'a été modifié. Relancez l'installation quand vous voulez." />
        <Control Id="Line" Type="Line" X="0" Y="232" Width="400" Height="0" />
        <Control Id="Finish" Type="PushButton" X="314" Y="241" Width="70" Height="22" Default="yes" Cancel="yes" Text="&amp;Terminer">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <!-- Shown by Windows Installer (Restart Manager) when an upgrade or repair must replace files
           that a running NadsPDF holds open. OK closes those programs (MSIRMSHUTDOWN=2) and
           continues; Cancel ends setup. -->
      <Dialog Id="MsiRMFilesInUse" Width="400" Height="220" Title="Installation de [ProductName]" KeepModeless="yes">
        <Control Id="Title" Type="Text" X="24" Y="15" Width="352" Height="22" Text="{\InstallerTitle}Fichiers en cours d'utilisation" />
        <Control Id="Description" Type="Text" X="24" Y="42" Width="352" Height="30"
            Text="Ces programmes utilisent des fichiers à mettre à jour. Cliquez sur OK pour les fermer et continuer, ou sur Annuler pour arrêter." />
        <Control Id="List" Type="ListBox" X="24" Y="78" Width="352" Height="70" Property="FileInUseProcess" Sunken="yes" TabSkip="yes" />
        <Control Id="OK" Type="PushButton" X="226" Y="186" Width="80" Height="22" Default="yes" Text="OK">
          <Publish Property="MSIRMSHUTDOWN" Value="2" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="314" Y="186" Width="70" Height="22" Cancel="yes" Text="Annuler">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="InstallWelcome" Before="InstallMaintenance" Condition="UILevel = 5 AND NOT Installed" />
        <Show Dialog="InstallMaintenance" Before="InstallProgress" Condition="UILevel = 5 AND Installed AND NOT REMOVE AND NOT REINSTALL" />
        <Show Dialog="InstallProgress" Before="ExecuteAction" Condition="UILevel = 5" />
        <Show Dialog="InstallComplete" OnExit="success" Condition="UILevel = 5" />
        <Show Dialog="InstallFailed" OnExit="error" Condition="UILevel = 5" />
        <Show Dialog="InstallCancelled" OnExit="cancel" Condition="UILevel = 5" />
      </InstallUISequence>
    </UI>
  </Fragment>
</Wix>
